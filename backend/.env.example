# Server Configuration
PORT=5000
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:5173

# Database Configuration (PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_USER=clausenova_user
DB_PASSWORD=clausenova_secret
DB_NAME=clausenova_db

# AI & LLM Providers (Optional - Built-in Intelligent Engine used if omitted)
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# Upload Limits
MAX_FILE_SIZE_MB=25
UPLOAD_DIR=tmp/uploads
